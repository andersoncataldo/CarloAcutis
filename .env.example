# Copie este arquivo para .env (ou .env.local) e preencha com os dados do
# seu banco Neon PostgreSQL (Vercel Storage > Neon > Quickstart).
# Nunca versione credenciais reais neste arquivo.
#
# IMPORTANTE: DATABASE_URL é usada EXCLUSIVAMENTE no servidor (Vercel Functions
# em api/* e scripts de migração). Nunca use prefixo VITE_ para credenciais
# de banco de dados.

DATABASE_URL=postgresql://usuario:senha@ep-seu-banco-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://usuario:senha@ep-seu-banco.sa-east-1.aws.neon.tech/neondb?sslmode=require
