# Copie este arquivo para .env e preencha com os valores do SEU projeto
# Supabase (Project Settings > API). Nunca use valores reais aqui - este
# arquivo e versionado no git.
#
# IMPORTANTE: use a chave "publishable"/"anon" publica, NUNCA a
# "service_role" - a service_role ignora RLS e nunca deve ir para o
# frontend nem para variaveis VITE_* (que ficam embutidas no bundle
# publico, visiveis a qualquer visitante do site).

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXX